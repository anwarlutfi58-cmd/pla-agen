package com.pla.agen.data.security

import androidx.test.ext.junit.runners.AndroidJUnit4
import androidx.test.platform.app.InstrumentationRegistry
import org.junit.Assert.assertEquals
import org.junit.Assert.assertNotEquals
import org.junit.Assert.assertNotNull
import org.junit.Assert.assertNull
import org.junit.Before
import org.junit.Test
import org.junit.runner.RunWith

@RunWith(AndroidJUnit4::class)
class CryptoManagerAndroidTest {

    private lateinit var cryptoManager: CryptoManager

    @Before
    fun setup() {
        InstrumentationRegistry.getInstrumentation().targetContext
        cryptoManager = CryptoManager()
    }

    @Test
    fun encryptAndDecrypt_roundTripSuccess() {
        val secretKey = "AIzaSyTestKeyForPlaAgenAndroidKeyStore98765"
        val encrypted = cryptoManager.encrypt(secretKey)
        assertNotNull(encrypted)
        assertNotEquals(secretKey, encrypted)
        assertNotEquals("", encrypted)

        val decrypted = cryptoManager.decrypt(encrypted)
        assertEquals(secretKey, decrypted)
    }

    @Test
    fun encrypt_producesDifferentIvEachCall() {
        val secretKey = "AIzaSySameKeyDifferentIvCheck1234567890"
        val firstCipher = cryptoManager.encrypt(secretKey)
        val secondCipher = cryptoManager.encrypt(secretKey)
        assertNotEquals(firstCipher, secondCipher)
        assertEquals(secretKey, cryptoManager.decrypt(firstCipher))
        assertEquals(secretKey, cryptoManager.decrypt(secondCipher))
    }

    @Test
    fun decrypt_returnsNullWhenCiphertextTampered() {
        val secretKey = "AIzaSyTamperCheckKey1234567890123456"
        val encrypted = cryptoManager.encrypt(secretKey)
        val parts = encrypted.split(":", limit = 2)
        assertEquals(2, parts.size)
        val tamperedCipherChars = parts[1].toCharArray()
        tamperedCipherChars[0] = if (tamperedCipherChars[0] == 'A') 'B' else 'A'
        val tampered = "${parts[0]}:${String(tamperedCipherChars)}"
        assertNull(cryptoManager.decrypt(tampered))
    }
}